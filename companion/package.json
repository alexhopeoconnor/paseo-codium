{
  "name": "paseo-codium-bridge",
  "displayName": "Paseo Codium Bridge",
  "description": "Connect this Codium window to its Paseo workspace editor panel.",
  "publisher": "alexhopeoconnor",
  "version": "0.1.2",
  "license": "MIT",
  "engines": {
    "vscode": "^1.143.0"
  },
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onFileSystem:paseo-codium-session"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "paseoCodiumProtocolVersion": 1,
  "repository": {
    "type": "git",
    "url": "https://github.com/alexhopeoconnor/paseo-codium.git"
  }
}
